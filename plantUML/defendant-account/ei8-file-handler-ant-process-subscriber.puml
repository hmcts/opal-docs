@startuml
title "File Handler - ANT File Queue Subscriber"
queue "ANT File Queue" as antFileQueue <<Queue>> #lightgreen
participant "ANT File Queue Subscriber" as fileHandlerService <<File Handler Service>> #LightSkyBlue
database "File Handler Database" as fileHandlerDb <<DB>> #LightGreen
database "Opal File Handling Blob Storage" as fileHandlingBlobStorage <<Blob Store>> #LightGreen

antFileQueue -> fileHandlerService ++ : Item placed onto queue
group DB Transaction
    alt Success
        fileHandlerService -> fileHandlerDb ++ : Check interface files table for supplied Fines Interface Job ID
        fileHandlerDb --> fileHandlerService -- : Check result returned
        alt Duplicate Fines Interface Job ID supplied
            fileHandlerService --> antFileQueue : Exit Process
        else Non Duplicate
            fileHandlerService -> fileHandlerDb ++ : Create new SOURCE_JSON interface file record
            fileHandlerDb --> fileHandlerService -- : Confirmation of creation in DB
            fileHandlerService -> fileHandlerService : Transform SOURCE_JSON to TRANSFORMED file (ANT file)
            fileHandlerService -> fileHandlerDb ++ : Create new TRANSFORMED file interface file record
            fileHandlerDb --> fileHandlerService -- : Confirmation of creation in DB
            fileHandlerService -> fileHandlingBlobStorage ++ : Upload SOURCE_JSON and TRANSFORMED file to opal blob store
            fileHandlingBlobStorage --> fileHandlerService -- : Confirmation of upload
            fileHandlerService --> fileHandlerService : Commit transaction
        end
    else Failure
        fileHandlerService -> fileHandlerService : Rollback database and blob store to clean slate
        fileHandlerService --> antFileQueue : Exit Process
    end
end
fileHandlerService --> antFileQueue -- : Exit process
@enduml
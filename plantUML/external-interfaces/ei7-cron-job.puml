@startuml
title "Fines - Cron Job"
participant "Kubernetes CronJob" as cronjob <<External System>> #LightCoral
participant "AllPay Out File Generation Service" as finesService <<Fines Service>> #LightSkyBlue
database "Fines Database" as finesDb <<DB>> #LightGreen
queue "Card Request Queue" as cardRequestQueue <<Queue>> #lightgreen

cronjob -> finesService ++ : Trigger process
group DB Transaction
    finesService -> finesDb ++ : Call Stored Procedure
    alt Success
        finesDb --> finesService : Return JSON list of requests to be processed and interface job ID
        finesService --> finesService : Commit
    else Failure
        finesDb --> finesService -- : Throws DB exception
        finesService --> cronjob : Rollback and exit process
    end
end
alt Empty JSON List
    group DB Transaction
        alt Success
            finesService -> finesDb ++ : Update the interface jobs to be completed
            finesDb --> finesService -- : Confirmation of update
            finesService --> finesService : Commit
        else Failure
            finesService --> cronjob : Rollback and exit process
        end
    end
else Non Empty JSON list from Stored Procedure
    finesService -> cardRequestQueue ++ : Send the JSON list to the queue for processing on the file handler service
    cardRequestQueue --> finesService -- : Confirmation of queue update
    group DB Transaction
        alt Success
            finesService -> finesDb ++ : Delete the records from the card payments requests table
            finesDb --> finesService -- : Confirmation of deletion
            finesService -> finesDb ++ : Update interface job record setting the status to Completed and completed_datetime
            finesDb --> finesService -- : Confirmation of update
            finesService -> finesDb ++ : Update defendant account's payment fields
            finesDb --> finesService -- : Confirmation of update
            finesService --> finesService : Commit
        else Failure
            finesService --> cronjob : Rollback and exit process
        end
    end
end
finesService --> cronjob -- : Exit process
@enduml
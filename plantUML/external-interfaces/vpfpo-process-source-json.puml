@startuml
title Transform the VPFPO file into source JSON and add to processing queue

participant "Opal File Handling Service" as fileHandlingService <<File Handling Service>> #LightSkyBlue
database "Opal File Handling Blob Storage" as fileHandlingBlobStorage #LightGreen
database "Opal File Handling Database" as fileHandlingDb #LightGreen
queue "Fines Draft Account queue" as finesDraftAccountQueue <<Queue>> #lightgreen

alt Creating Source JSON
    fileHandlingService -> fileHandlingService : Create the source JSON file using the extract data from the source file and reference data from the database
    fileHandlingService -> fileHandlingBlobStorage ++ : Store source JSON in blob storage
    fileHandlingBlobStorage --> fileHandlingService -- : Confirmation of storage with location metadata
else Source JSON Failure
    fileHandlingService[#red]-> fileHandlingService : Handled in EI2
    fileHandlingService -> fileHandlingService : Exit Process
end
fileHandlingService -> fileHandlingDb ++ : Store all Registrations with CREATED status
fileHandlingDb --> fileHandlingService -- : Confirmation of storage

alt For each Registration above
    fileHandlingService -> fileHandlingDb ++ : Using the extract data from the source file locate the relevant reference data (opal processing domain, etc)
    fileHandlingDb --> fileHandlingService -- : Return data
else Draft Account JSON error
    fileHandlingService -> fileHandlingService : Mark file in interfaceFile table as failed. This should auto-retry next time due to EI2 mechanism.
    fileHandlingService -> fileHandlingService : Exit Process
end

fileHandlingService -> fileHandlingDb ++ : Store file metadata in database (JPA) with a success status
fileHandlingDb --> fileHandlingService -- : Confirmation of update

fileHandlingService -> finesDraftAccountQueue ++ : Send JSON Draft Account payload to queue (will be duplicate check in subscriber)
finesDraftAccountQueue --> fileHandlingService -- : Confirmation of message sent

fileHandlingService -> fileHandlingDb ++ : Update Registrations to be SUBMITTED
fileHandlingDb --> fileHandlingService -- : Confirmation of update

fileHandlingService -> fileHandlingDb ++ : Mark status as successfully processed in database (JPA) or if error occurs mark as failed with error message in database (JPA)
fileHandlingDb --> fileHandlingService -- : Confirmation of update

@enduml
@startuml
actor "User" as user
participant "Manage Alternate Payment Reference" as uiPage <<UI Page>> #lightskyblue
participant "Alternate Payment References Service" as alternatePaymentReferencesService <<Opal Fines Service>> #lightgreen
database "Alternate Payment References table" as aprTable <<Fines DB>>#lightgreen

user -> uiPage ++ : Loads page
uiPage -> alternatePaymentReferencesService ++ : GET /defendant-account/{defendantAccountId}/APRs
alternatePaymentReferencesService -> aprTable ++ : Get APR records for that defendant account
aprTable --> alternatePaymentReferencesService -- : Return records
alternatePaymentReferencesService --> uiPage -- : Return list of APRs for that defendant account
uiPage --> user -- : APRs displayed
@enduml
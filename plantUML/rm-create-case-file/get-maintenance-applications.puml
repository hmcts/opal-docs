@startuml
actor "Inputter" as user
participant "Order Details\n<i>UI</i>" as page <<UI Page>> #lightskyblue
participant "Get Maintenance Applications\nGET /maintenance-applications" as api <<RM API>> #lightgreen
database "RM Database" as db <<MAINTENANCE_APPLICATIONS>> #Yellow

user -> page : Open Order Details
page -> api ++ : application_group=Create Casefile,\nactive=true
api -> db ++ : Retrieve matching active applications (JPA)
db --> api -- : Application records
api --> page -- : JSON including application_id,\napplication_code, application_title\nand application_group
page --> user : Display application selector
@enduml

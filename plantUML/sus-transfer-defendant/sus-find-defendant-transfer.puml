@startuml
actor "User" as user
participant "Find Defendant to Transfer" as transferFind <<UI Page>> #lightskyblue
participant "Confirm Defendant Details and Transfer" as transferConfirm <<UI Page>> #lightskyblue
participant "Search Defendant Account" as srcDefAcc <<Fines API>> #lightgreen
participant "Get Defendant Account At A Glance" as getDefAcc <<Fines API>> #lightgreen
database "Fines DB" as db <<View>> #yellow

user -> transferFind ++: Input Account Number and Search
transferFind -> srcDefAcc ++: Search Defendant Account \nby Account Number and Business Unit ID
srcDefAcc -> db ++: Query View with Account Number and Business Unit ID
db --> srcDefAcc --: Return Defendant Account summary
srcDefAcc --> transferFind --: Return Defendant Account summary
transferFind -> getDefAcc ++: Get Defendant Account At A Glance details by summary ID
getDefAcc -> db ++: Query View with Defendant Account ID
db --> getDefAcc --: Return Defendant Account At A Glance details
getDefAcc --> transferFind --: Return Defendant Account At A Glance details
transferFind -> transferConfirm --++: Display Defendant Account At A Glance details

@enduml
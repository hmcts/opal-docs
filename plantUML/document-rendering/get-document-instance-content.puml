@startuml
title Get document instance content
actor "Opal User" as user
participant "Get Document Instance Content" as finesService <<Fines Service API>> #LightSkyBlue
database "Opal Fines Database" as finesDb #LightGreen
database "Documents Blob Storage Container" as documentsContainer #LightGreen
queue "pdpl-logging-queue" as pdplQueue <<Logging Service Queue>> #lightgreen

user -> finesService ++ : Request to get document instance content
finesService -> finesService : Checks if feature flag for this API is enabled
finesService -> finesDb ++ : Get associated Document instance
finesDb --> finesService -- : Return associated Document Instance record

alt Document Instance found
    finesService -> finesService : Checks if the document instance exists for requested type and is downloadable
        alt Document instance content is downloadable
            finesService -> documentsContainer ++ : Get document instance content from blob storage
            documentsContainer --> finesService -- : Return document instance content
            opt isFirstDownload
                finesService --> finesDb ++ : Update document instance record with update status to DOWNLOADED and update the downloaded by / at fields
                finesDb --> finesService -- : Confirmation of document instance record update
            end
            finesService --> pdplQueue ++ : Log document instance rendering request (Using pdpl data from document instance record)
            pdplQueue --> finesService -- : Confirmation of message sent
            finesService -> user : Return success response with document instance content
        else Document instance content is not for downloadable
            finesService -> user : Return error response indicating the document instance is not ready for download or the requested type is not applicable
        end
else Document Instance not found
    finesService -> user : Return error response indicating the document instance could not be located
end
@enduml